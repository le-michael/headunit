# Absolute path to your host music library directory (required).
MUSIC_DIR=/path/to/your/music

# Docker volume mount options for the read-only music directory.
# On SELinux-enforcing hosts, set to ro,z (avoid :z on /home/$USER or NFS/SMB mounts).
MUSIC_MOUNT_OPTS=ro

# Host TCP port mapped to container port 4533.
HOST_PORT=4533

# Non-root user/group IDs used to own /data and run Headunit inside the container.
PUID=1000
PGID=1000

# Periodic background library scan interval (Go duration, e.g. 5m, 1h, or 0 to disable periodic scans).
SCAN_INTERVAL=5m

# Optional 64-character hex (32-byte) AES-256-GCM key for encrypting stored user passwords at rest.
# When left empty, Headunit auto-generates and persists a 0600 key file at /data/auth.key.
# Headunit enforces fail-closed authentication (zero users rejects /rest/* requests); after startup
# or upgrade, provision an admin user with:
#   ./scripts/headunit-ctl.sh user create --username <name> --admin
AUTH_SECRET_KEY=
